# ==============================================================================
# KiranIA OS — Enterprise AI Platform Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LiteLLM Proxy Gateway Configuration
# ------------------------------------------------------------------------------
# Base URL where LiteLLM Proxy is listening.
# In local development: http://127.0.0.1:4000/v1
# In Docker Compose: http://litellm:4000/v1
LITELLM_URL="http://127.0.0.1:4000/v1"

# Master API key used by backend to communicate with LiteLLM proxy.
# Leave it empty to have a strong random key generated per process (dev only).
# In production set the SAME value here and in litellm_config.yaml so the
# backend and an externally managed proxy agree.
LITELLM_MASTER_KEY=""

# Local daemon port and host
LITELLM_PORT="4000"
LITELLM_HOST="0.0.0.0"

# ------------------------------------------------------------------------------
# 2. AI Model Providers (Configured server-side, never exposed to browser)
# ------------------------------------------------------------------------------

# Google Gemini (Primary & Fallback)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# OpenAI (GPT-4o, o1, GPT-4o-mini)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus)
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# DeepSeek (DeepSeek V3, DeepSeek R1)
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# Groq LPUs (Ultra-fast Llama 3.3 70B ~500 T/s)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=""

# OpenRouter (Unified multi-provider gateway)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Mistral AI (Mistral Large 2, Codestral)
# Get key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=""

# xAI (Grok 2)
# Get key: https://x.ai/api
XAI_API_KEY=""

# Cohere (Command R+)
# Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=""

# NVIDIA NIM (Accelerated inference)
# NVIDIA_NIM_API_KEY is the canonical name; NVIDIA_API_KEY is accepted as a fallback.
# Get key: https://build.nvidia.com/
NVIDIA_NIM_API_KEY=""
NVIDIA_API_KEY=""

# Hugging Face Inference (HF_TOKEN is the canonical name; HUGGINGFACE_API_KEY accepted)
# Get token: https://huggingface.co/settings/tokens
HF_TOKEN=""
HUGGINGFACE_API_KEY=""

# Azure OpenAI (optional secondary provider routed by the gateway)
AZURE_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Stripe Billing & Subscriptions
# ------------------------------------------------------------------------------
# Secret API key from Stripe Dashboard (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=""

# Webhook secret to verify incoming Stripe subscription events
STRIPE_WEBHOOK_SECRET=""

# Stripe Price IDs for recurrent subscriptions
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_BUSINESS=""

# ------------------------------------------------------------------------------
# 4. Application Runtime Settings
# ------------------------------------------------------------------------------
PORT="3000"
NODE_ENV="development"
DISABLE_HMR="false"

# Comma-separated list of browser origins allowed by the backend CORS policy.
# Leave empty for permissive local development; set explicitly in production,
# e.g. ALLOWED_ORIGINS="https://kiranai.web.app,https://app.kiranai.com"
ALLOWED_ORIGINS=""

# Set to "true" only when running behind a trusted reverse proxy / load balancer
# (Cloud Run, Railway, Nginx). Enables Express "trust proxy" so per-IP rate
# limiting sees the real client address via X-Forwarded-For. Leave empty when
# the app is directly exposed, otherwise a client could spoof its own IP.
TRUST_PROXY=""

# ------------------------------------------------------------------------------
# 5. Administration
# ------------------------------------------------------------------------------
# Comma-separated list of emails that receive the admin role. Admin is granted
# ONLY to these; no address is hardcoded and no default password exists. Register
# the account normally, then add its email here (and restart) to promote it.
# e.g. ADMIN_EMAILS="owner@yourdomain.com"
ADMIN_EMAILS=""

# ------------------------------------------------------------------------------
# 6. Frontend build-time configuration (Vite)
# ------------------------------------------------------------------------------
# Optional absolute URL of the backend API when the frontend is served from a
# different origin. Leave empty when the backend serves the SPA (same origin).
VITE_API_BASE_URL=""

# Google OAuth client ID (used by the "Sign in with Google" button). The
# backend verifies the resulting id_token; set GOOGLE_OAUTH_CLIENT_ID too.
VITE_GOOGLE_OAUTH_CLIENT_ID=""

# Backend-side expected audience for Google id_tokens (must match the client id
# above). Only required when enabling Google Sign-In.
GOOGLE_OAUTH_CLIENT_ID=""

# Dev-only: where the Vite dev server proxies /api requests. Defaults to
# http://127.0.0.1:3000 (the Express backend). Not used in production builds.
VITE_API_PROXY_TARGET=""

# ------------------------------------------------------------------------------
# 7. Privileged persistence (Firebase Admin SDK)
# ------------------------------------------------------------------------------
# The backend must write credit ledgers, subscriptions and transactions with
# server privileges. Provide ONE of the following so it can use firebase-admin:
#
#   a) FIREBASE_SERVICE_ACCOUNT_JSON  — the full service-account JSON as a single
#      line, or its base64 encoding. Recommended for PaaS secret managers.
#   b) GOOGLE_APPLICATION_CREDENTIALS — path to a service-account key file.
#   c) Application Default Credentials — automatic on Cloud Run / App Engine
#      (grant the runtime service account the "Cloud Datastore User" role).
#
# Without any of these the app still runs, but Firestore writes are skipped and
# only the local data/ directory persists. Never commit a real key.
FIREBASE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPLICATION_CREDENTIALS=""
