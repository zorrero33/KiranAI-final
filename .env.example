# ==============================================================================
# KiranIA OS — Enterprise AI Platform Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LiteLLM Proxy Gateway Configuration
# ------------------------------------------------------------------------------
# Base URL where LiteLLM Proxy is listening.
# In local development: http://127.0.0.1:4000/v1
# In Docker Compose: http://litellm:4000/v1
LITELLM_URL="http://127.0.0.1:4000/v1"

# Master API key used by backend to communicate with LiteLLM proxy
LITELLM_MASTER_KEY="sk-litellm-master-secret-key"

# Local daemon port and host
LITELLM_PORT="4000"
LITELLM_HOST="0.0.0.0"

# ------------------------------------------------------------------------------
# 2. AI Model Providers (Configured server-side, never exposed to browser)
# ------------------------------------------------------------------------------

# Google Gemini (Primary & Fallback)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# OpenAI (GPT-4o, o1, GPT-4o-mini)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus)
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# DeepSeek (DeepSeek V3, DeepSeek R1)
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# Groq LPUs (Ultra-fast Llama 3.3 70B ~500 T/s)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=""

# OpenRouter (Unified multi-provider gateway)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Mistral AI (Mistral Large 2, Codestral)
# Get key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=""

# xAI (Grok 2)
# Get key: https://x.ai/api
XAI_API_KEY=""

# Cohere (Command R+)
# Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=""

# NVIDIA NIM (Accelerated inference)
NVIDIA_NIM_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Stripe Billing & Subscriptions
# ------------------------------------------------------------------------------
# Secret API key from Stripe Dashboard (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=""

# Webhook secret to verify incoming Stripe subscription events
STRIPE_WEBHOOK_SECRET=""

# Stripe Price IDs for recurrent subscriptions
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_BUSINESS=""

# ------------------------------------------------------------------------------
# 4. Application Runtime Settings
# ------------------------------------------------------------------------------
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:3000"
DISABLE_HMR="false"
